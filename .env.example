# Secret used to sign owner login tokens (JWT). Use a long random string.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# PIN for the owner app login. It is hashed with bcrypt when the test shop is created.
OWNER_PIN=change-me

# Host or IP the frontends use to reach this backend (used for redirects and CORS).
HOST_IP=localhost

# Optional. Defaults to a local SQLite file (stampcard.db) when unset.
# DATABASE_URL=postgresql://postgres:devpass@localhost:5433/stampcard

# Optional. Without these, Google Wallet runs in mock mode (fake pass links).
# GOOGLE_WALLET_ISSUER_ID=your-issuer-id
# Also needs service-account.json in the project root.